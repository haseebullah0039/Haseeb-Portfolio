# ── Contact form → your Gmail ────────────────────────────────────────────
# Copy this file to .env.local (never commit it) and fill in:
#   GMAIL_USER          the Gmail account that sends the messages
#   GMAIL_APP_PASSWORD  a 16-character App Password for that account
#                       (Google Account → Security → 2-Step Verification → App passwords)
# Messages are delivered to `contact.formEmail` in src/data/site.ts.
# On Vercel (or any host), add the same two variables in the project's
# Environment Variables settings, then redeploy.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional: a different backup JSON endpoint (default: FormSubmit.co).
NEXT_PUBLIC_FORM_ENDPOINT=
